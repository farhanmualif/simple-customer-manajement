# Salin file ini menjadi .env lalu isi nilainya

# Koneksi database PostgreSQL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://postgres:password@localhost:5432/rtrw_wifi"

# Secret untuk enkripsi session (minimal 32 karakter, isi dengan karakter acak)
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter-ini"
