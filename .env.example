# Salin file ini menjadi .env lalu isi nilainya

# Supabase PostgreSQL connection string
# Ambil dari: Supabase Dashboard → Project Settings → Database → Connection string → URI
# PENTING: tambahkan ?pgbouncer=true&connection_limit=1 di akhir (untuk Vercel/serverless)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true&connection_limit=1"

# Secret untuk enkripsi session — isi string acak minimal 32 karakter
# Generate contoh: openssl rand -base64 32
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"
